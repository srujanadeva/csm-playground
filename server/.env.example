# Copied to server/.env by "npm run setup", which replaces every change-me value with a
# freshly generated random secret. The server refuses to start while any change-me remains.
NODE_ENV=development
PORT=4001
MONGO_URI=mongodb://127.0.0.1:27017/csm_playground
JWT_SECRET=change-me
CSRF_SECRET=change-me
# 64 hex characters (32 bytes) for AES-256-GCM field encryption of ID numbers.
PII_ENC_KEY=change-me
CORS_ORIGINS=https://localhost:3001
LOG_LEVEL=info
